[
  {"name":"block collections and compact mapping", "yaml":"# mission\n---\nname: rover\nsteps:\n  - id: scan\n    flags: [true, false, null]\n  - id: mine\n    settings: {speed: 1.5, retries: 2}\n...\n", "value":{"name":"rover","steps":[{"id":"scan","flags":[true,false,null]},{"id":"mine","settings":{"speed":1.5,"retries":2}}]}},
  {"name":"nested compact sequences", "yaml":"- - one\n  - two\n- - three\n  - four\n", "value":[["one","two"],["three","four"]]},
  {"name":"quotes comments and punctuation", "yaml":"plain: don't panic # comment\nhash: a#b\nurl: https://example.test/a\nsingle: 'it''s # literal'\ndouble: \"line\\nnext\\t\\u263a\"\n\"colon:key\": \"true\"\n", "value":{"plain":"don't panic","hash":"a#b","url":"https://example.test/a","single":"it's # literal","double":"line\nnext\t☺","colon:key":"true"}},
  {"name":"flow nesting and empty values", "yaml":"{name: rover, missing: , tags: [a, b,], nested: {\"x\":1}, empty: {}, list: []}", "value":{"name":"rover","missing":null,"tags":["a","b"],"nested":{"x":1},"empty":{},"list":[]}},
  {"name":"empty block values", "yaml":"a:\nb: # empty\nc:\n  -\n  - null\n", "value":{"a":null,"b":null,"c":[null,null]}},
  {"name":"core scalar resolution", "yaml":"[NULL, Null, ~, TRUE, False, yes, no, on, 012, 0x10, 0o10, +2, .5, 1., 2e3, 2026-09-24]", "value":[null,null,null,true,false,"yes","no","on",12,16,8,2,0.5,1,2000,"2026-09-24"]},
  {"name":"literal clip strip and keep", "yaml":"clip: |\n  alpha\n  beta\n\nstrip: |-\n  gamma\n\nkeep: |+\n  delta\n\n", "value":{"clip":"alpha\nbeta\n","strip":"gamma","keep":"delta\n\n"}},
  {"name":"folded paragraphs and indented text", "yaml":"text: >-\n  first\n  second\n\n  third\n    code\n  last\n", "value":{"text":"first second\nthird\n  code\nlast"}},
  {"name":"block scalar without terminal line break", "yaml":"text: |\n  last", "value":{"text":"last"}},
  {"name":"empty scalar and blank document", "yaml":"# only a comment\n---\n...\n", "value":null},
  {"name":"prototype keys are ordinary data", "yaml":"__proto__: 7\nconstructor: 8\nprototype: 9\n", "value":{"__proto__":7,"constructor":8,"prototype":9}},
  {"name":"duplicate block key", "yaml":"name: one\nname: two", "error":[2,1]},
  {"name":"duplicate quoted flow key", "yaml":"{name: one, \"name\": two}", "reject":true},
  {"name":"numeric keys", "yaml":"42: value", "error":[1,1]},
  {"name":"complex keys", "yaml":"? [a, b]\n: value", "reject":true},
  {"name":"anchors", "yaml":"value: &shared [1, 2]", "reject":true},
  {"name":"aliases", "yaml":"value: *shared", "reject":true},
  {"name":"tags", "yaml":"value: !!str 42", "reject":true},
  {"name":"merge", "yaml":"<<: {a: 1}", "reject":true},
  {"name":"multiple documents", "yaml":"---\na: 1\n---\nb: 2", "error":[3,1]},
  {"name":"directives", "yaml":"%YAML 1.2\n---\na: 1", "reject":true},
  {"name":"tab indentation", "yaml":"a:\n\tb: 1", "error":[2,1]},
  {"name":"invalid indentation", "yaml":"a:\n  b: 1\n c: 2", "error":[3,2]},
  {"name":"multiline flow", "yaml":"a: [1,\n  2]", "reject":true},
  {"name":"multiline plain", "yaml":"a: first\n  second", "reject":true},
  {"name":"indentless sequence", "yaml":"a:\n- one", "reject":true},
  {"name":"explicit block indent", "yaml":"a: |2\n  text", "reject":true},
  {"name":"infinite number", "yaml":".inf", "reject":true},
  {"name":"negative zero", "yaml":"-0", "reject":true},
  {"name":"empty flow item", "yaml":"[1,,2]", "reject":true},
  {"name":"missing flow comma", "yaml":"[\"a\" \"b\"]", "reject":true},
  {"name":"missing flow value colon", "yaml":"{a b}", "reject":true},
  {"name":"unknown escape", "yaml":"\"\\q\"", "reject":true},
  {"name":"unterminated quote", "yaml":"'unfinished", "reject":true}
